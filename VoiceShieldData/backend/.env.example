.env.example
# VoiceShield API Configuration

# Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Model
MODEL_PATH=../models/voiceshield_best/model.pt

# Upload Configuration
MAX_FILE_SIZE=52428800  # 50 MB in bytes
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
