# ==============================================================================
# VoiceShield Environment Configuration
# ==============================================================================

# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=*

# Authentication Secrets
JWT_SECRET=replace-with-a-secure-random-256-bit-key
JWT_REFRESH_SECRET=replace-with-a-secure-random-refresh-key

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/voiceshield
DB_POOL_MIN=2
DB_POOL_MAX=20

# Cache & Asynchronous Queue (Redis + BullMQ)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Machine Learning Inference Service
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=30000
MODEL_PATH=../models/voiceshield_best/model.pt

# Storage & Audio Retention
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
AUDIO_RETENTION_DAYS=30

# Rate Limiting
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_AUTH=20
RATE_LIMIT_DETECTION=30
